{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.adamsjack711-ux/pkgxray",
  "title": "pkgxray",
  "description": "Pre-install security scans for npm packages, MCP servers, and AI agents with cited verdict evidence.",
  "websiteUrl": "https://pkgxray.ca/",
  "icons": [
    {
      "src": "https://pkgxray.ca/assets/favicon.svg",
      "mimeType": "image/svg+xml",
      "sizes": [
        "any"
      ]
    }
  ],
  "repository": {
    "url": "https://github.com/adamsjack711-ux/pkgxray",
    "source": "github",
    "id": "1276320499"
  },
  "version": "2.0.0",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.pkgxray.ca/mcp"
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "pkgxray",
      "version": "2.0.0",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp-server"
        }
      ]
    }
  ]
